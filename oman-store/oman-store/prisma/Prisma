// ============================================================
// Oman Store - Prisma Schema
// PostgreSQL. Run: npx prisma migrate dev --name init
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Enums ----------------

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  ORDERED_FROM_SUPPLIER
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum ImportSource {
  TEMU
  ALIEXPRESS
  MANUAL
}

enum ImportStatus {
  PENDING
  SUCCESS
  FAILED
  MANUAL_FALLBACK
}

enum NotificationType {
  ORDER_CONFIRMED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  GENERIC
}

// ---------------- Users & Auth ----------------

model User {
  id            String   @id @default(cuid())
  fullName      String
  email         String   @unique
  phone         String?
  passwordHash  String
  role          Role     @default(CUSTOMER)
  emailVerified DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  addresses     Address[]
  orders        Order[]
  cart          Cart?
  wishlist      WishlistItem[]
  reviews       Review[]
  notifications Notification[]

  @@index([email])
}

model Address {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  phone             String
  governorate       String
  wilayat           String
  additionalDetails String?
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())

  orders Order[]

  @@index([userId])
}

// ---------------- Catalog ----------------

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryToSub", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToSub")
  products Product[]

  @@index([slug])
}

model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String
  sku            String   @unique
  sellingPrice   Decimal  @db.Decimal(10, 3) // OMR uses 3 decimal places
  originalPrice  Decimal? @db.Decimal(10, 3)
  discountPct    Int?     // computed/stored for display
  stock          Int      @default(0)
  isPublished    Boolean  @default(false)
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])

  // Supplier / import metadata — ADMIN ONLY, never exposed to customers
  supplierUrl    String?
  supplierPrice  Decimal? @db.Decimal(10, 3)
  importSource   ImportSource @default(MANUAL)

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images       ProductImage[]
  variants     ProductVariant[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  wishlistedBy WishlistItem[]
  reviews      Review[]
  importRecord ProductImport?

  @@index([categoryId])
  @@index([isPublished])
  @@index([slug])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int     @default(0)

  @@index([productId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String  // e.g. "Color", "Size"
  value     String  // e.g. "Red", "XL"
  extraPrice Decimal @default(0) @db.Decimal(10, 3)
  stock     Int     @default(0)

  @@index([productId])
}

// Tracks every import attempt for auditing, independent of ProductImporter internals
model ProductImport {
  id            String       @id @default(cuid())
  productId     String?      @unique
  product       Product?     @relation(fields: [productId], references: [id])
  sourceUrl     String
  source        ImportSource
  status        ImportStatus
  rawPayload    Json?        // raw extracted data snapshot for debugging
  errorMessage  String?
  createdAt     DateTime     @default(now())

  @@index([status])
}

// ---------------- Cart / Wishlist ----------------

model Cart {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  variantId String?

  @@index([cartId])
}

model WishlistItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ---------------- Orders / Payments ----------------

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique // human-readable, e.g. OM-20260903-0001
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  addressId     String
  address       Address       @relation(fields: [addressId], references: [id])

  subtotal      Decimal       @db.Decimal(10, 3)
  shippingFee   Decimal       @db.Decimal(10, 3)
  total         Decimal       @db.Decimal(10, 3)

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  productName  String  // snapshot at purchase time
  unitPrice    Decimal @db.Decimal(10, 3) // snapshot of sellingPrice at purchase time
  quantity     Int
  variantLabel String?

  @@index([orderId])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        String        // e.g. "thawani"
  providerRef     String?       // gateway session/transaction id
  amount          Decimal       @db.Decimal(10, 3)
  status          PaymentStatus @default(UNPAID)
  createdAt       DateTime      @default(now())

  @@index([orderId])
}

// ---------------- Reviews / Notifications / Settings ----------------

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int      // 1-5
  comment   String
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
}

model ShippingSetting {
  id           String  @id @default(cuid())
  governorate  String  @unique
  fee          Decimal @db.Decimal(10, 3)
  updatedAt    DateTime @updatedAt
}

model StoreSetting {
  id                 String  @id @default("singleton")
  storeName          String  @default("متجرنا")
  storeLogoUrl       String?
  storeDescription   String?
  contactPhone       String?
  contactEmail       String?
  currency           String  @default("OMR")
  taxPercent         Decimal @default(0) @db.Decimal(5, 2)
  privacyPolicy      String?
  termsAndConditions String?
  refundPolicy       String?
  shippingPolicy     String?
}
